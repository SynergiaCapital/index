<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Synergia Planner v2.1</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f7fb;margin:0;color:#222}
header{background:#0b4f8a;color:#fff;padding:18px;text-align:center}
.container{max-width:900px;margin:auto;padding:20px}
.card{background:#fff;border-radius:10px;padding:18px;margin:16px 0;box-shadow:0 2px 8px rgba(0,0,0,.1)}
label{display:block;margin-top:12px;font-weight:bold}
input{width:100%;padding:10px;border:1px solid #ccc;border-radius:6px}
button{margin-top:18px;padding:12px 20px;border:none;border-radius:6px;background:#0b4f8a;color:#fff;font-size:16px;cursor:pointer}
.result{margin-top:20px;padding:15px;background:#eef6ff;border-radius:8px}
.badge{font-weight:bold;padding:8px 14px;border-radius:20px;color:#fff;display:inline-block}
.green{background:#2e7d32}.yellow{background:#f9a825}.red{background:#c62828}
small{color:#666}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>
<body>
<header>
<h1>Synergia Planner v2.1</h1>
<p>Planeación Estratégica para el Retiro</p>
</header>

<div class="container">
<div class="card">
<h2>Diseñar mi Plan de Retiro</h2>

<label>Nombre</label>
<input id="nombre">

<label>Edad actual</label>
<input id="edad" type="number" value="35">

<label>Edad de retiro</label>
<input id="retiro" type="number" value="65">

<label>Pensión mensual deseada (pesos de hoy)</label>
<input id="pension" type="number" value="30000">

<label>Ahorro mensual</label>
<input id="ahorro" type="number" value="5000">

<label>Saldo inicial</label>
<input id="saldo" type="number" value="0">

<button onclick="calcular()">Diseñar mi Plan</button>
<button onclick="generarPDF()">Generar PDF</button>

<div id="salida" class="result" style="display:none"></div>

<small>Supuestos internos: Rendimiento nominal 10%, inflación 4%, incremento anual de aportaciones 4%, referencia Allianz Dinámico USD.</small>
</div>
</div>

<script>
let ultimo="";

function dinero(v){
 return new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(v);
}

function calcular(){

 const edad=+edadEl().value;
 const retiro=+retiroEl().value;
 const pension=+pensionEl().value;
 const ahorro=+ahorroEl().value;
 const saldo=+saldoEl().value;

 const años=retiro-edad;

 const r=0.10/12;
 const n=años*12;

 let futuroSaldo=saldo*Math.pow(1+r,n);

 for(let i=0;i<n;i++){
    futuroSaldo+=ahorro*Math.pow(1+r,n-i);
 }

 const capitalHoy=pension*180;
 const capitalRetiro=capitalHoy*Math.pow(1.04,años);

 let estado="REQUIERE REESTRUCTURA",clase="red";

 if(futuroSaldo>=capitalRetiro){
   estado="EN RUTA";
   clase="green";
 }else if(futuroSaldo>=capitalRetiro*.80){
   estado="REQUIERE AJUSTE";
   clase="yellow";
 }

 const dif=capitalRetiro-futuroSaldo;

 ultimo=`
 <h3>Resultado</h3>
 <p><b>Capital requerido hoy:</b> ${dinero(capitalHoy)}</p>
 <p><b>Capital requerido al retiro:</b> ${dinero(capitalRetiro)}</p>
 <p><b>Capital proyectado:</b> ${dinero(futuroSaldo)}</p>
 <p><b>Diferencia:</b> ${dinero(dif)}</p>
 <p><span class="badge ${clase}">${estado}</span></p>
 <p><b>Recomendación:</b> ${
 estado=="EN RUTA"?
 "Continúe con el plan y realice una revisión anual.":
 estado=="REQUIERE AJUSTE"?
 "Considere incrementar su ahorro mensual o extender la edad de retiro.":
 "Es recomendable rediseñar el plan incrementando el ahorro y revisando el objetivo."
 }</p>`;

 document.getElementById("salida").style.display="block";
 document.getElementById("salida").innerHTML=ultimo;
}

function generarPDF(){
 if(!ultimo){calcular();}
 const {jsPDF}=window.jspdf;
 const doc=new jsPDF();
 doc.setFontSize(18);
 doc.text("Synergia Planner v2.1",20,20);
 doc.setFontSize(12);
 doc.text("Planeación Estratégica para el Retiro",20,30);
 const txt=document.getElementById("salida").innerText.split("\n");
 let y=45;
 txt.forEach(t=>{doc.text(t,20,y);y+=8;});
 doc.save("SynergiaPlanner.pdf");
}
const edadEl=()=>document.getElementById("edad");
const retiroEl=()=>document.getElementById("retiro");
const pensionEl=()=>document.getElementById("pension");
const ahorroEl=()=>document.getElementById("ahorro");
const saldoEl=()=>document.getElementById("saldo");
</script>
</body>
</html>
